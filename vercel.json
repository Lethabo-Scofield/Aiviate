{
  "version": 2,
  "installCommand": "cd Website && npm ci --no-audit --no-fund",
  "buildCommand": "cd Website && npm run build",
  "outputDirectory": "Website/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://aviate-api.azurewebsites.net/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
