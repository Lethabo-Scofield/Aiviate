{
  "version": 2,
  "installCommand": "cd Website && npm ci --no-audit --no-fund",
  "buildCommand": "cd Website && npm run build",
  "outputDirectory": "Website/dist",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 60,
      "includeFiles": "Website/backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
