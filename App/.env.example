# Aiviate Driver App — environment configuration
# Copy to `.env` (App/.env) and adjust. Only EXPO_PUBLIC_* vars are inlined
# into the client bundle by Expo/Metro. Never put secrets here — everything in
# this file ships to the device.

# Base URL of the Aiviate operational API (Website/backend). Include the /api
# suffix. For native devices on a LAN backend, use your machine IP or a tunnel.
#   Web / iOS simulator:   http://localhost:8000/api
#   Android emulator:      http://10.0.2.2:8000/api
#   Real device / staging: https://api.aiviate.example.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Deep-link scheme used by activation links. Must match app.json `expo.scheme`.
EXPO_PUBLIC_APP_SCHEME=aviate

# Feature flags (default off). Enable only when the backing service is configured.
EXPO_PUBLIC_FEATURE_SAFETY_DEVICE=false
EXPO_PUBLIC_FEATURE_PUSH=false
